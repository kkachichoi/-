 "subs": [
  {
   "text": "안녕하세요",
   "from": 8,
   "to": 33
  },
  {
   "text": "까치카페 사장입니다",
   "from": 33,
   "to": 73
  },
  {
   "text": "저는 커피를 직접 볶고",
   "from": 84,
   "to": 149
  },
  {
   "text": "스콘과 베이글을 굽고 있어요",
   "from": 149,
   "to": 214
  },
  {
   "text": "손으로 만드는 한 잔",
   "from": 226,
   "to": 284
  },
  {
   "text": "한 접시에도",
   "from": 289,
   "to": 325
  },
  {
   "text": "작품 같은 정성을 담고 싶어서요",
   "from": 325,
   "to": 400
  },
  {
   "text": "원두는 매장에서 직접 볶아서",
   "from": 412,
   "to": 480
  },
  {
   "text": "향이 살아 있을 때",
   "from": 480,
   "to": 516
  },
  {
   "text": "내려 드리고요",
   "from": 516,
   "to": 542
  },
  {
   "text": "스콘과 베이글도",
   "from": 560,
   "to": 612
  },
  {
   "text": "매일 아침 반죽해서 구워요",
   "from": 612,
   "to": 671
  },
  {
   "text": "사실 저는",
   "from": 683,
   "to": 717
  },
  {
   "text": "일본 무사시노미술대학에서",
   "from": 717,
   "to": 784
  },
  {
   "text": "미술을 공부했어요",
   "from": 784,
   "to": 822
  },
  {
   "text": "흙을 빚고",
   "from": 832,
   "to": 864
  },
  {
   "text": "작품을 걸고",
   "from": 873,
   "to": 907
  },
  {
   "text": "전시를 준비하던 날들이었죠",
   "from": 915,
   "to": 972
  },
  {
   "text": "그런데 작품을 만드는 일과",
   "from": 981,
   "to": 1051
  },
  {
   "text": "커피를 만드는 일이",
   "from": 1051,
   "to": 1095
  },
  {
   "text": "참 닮았더라고요",
   "from": 1095,
   "to": 1133
  },
  {
   "text": "재료를 고르고",
   "from": 1158,
   "to": 1193
  },
  {
   "text": "손으로 다듬고",
   "from": 1196,
   "to": 1229
  },
  {
   "text": "누군가의 앞에 내놓는 일이요",
   "from": 1237,
   "to": 1301
  },
  {
   "text": "미술대학 우수 졸업생이던 제가",
   "from": 1334,
   "to": 1399
  },
  {
   "text": "이제는 13년째 한곳에서",
   "from": 1409,
   "to": 1488
  },
  {
   "text": "커피를 내리고 있어요",
   "from": 1488,
   "to": 1526
  },
  {
   "text": "요즘은 아침마다 커피를 내리고",
   "from": 1536,
   "to": 1608
  },
  {
   "text": "빵이 구워지는 동안",
   "from": 1618,
   "to": 1660
  },
  {
   "text": "새 메뉴를 그려 보곤 해요",
   "from": 1660,
   "to": 1712
  },
  {
   "text": "까치카페를 찾아 주시는 분들 덕분에",
   "from": 1721,
   "to": 1794
  },
  {
   "text": "요즘 정말 행복해요",
   "from": 1794,
   "to": 1844
  },
  {
   "text": "앞으로도",
   "from": 1862,
   "to": 1884
  },
  {
   "text": "맛있는 커피와 빵으로 기다릴게요",
   "from": 1884,
   "to": 1959
  },
  {
   "text": "자주 들러 주세요!",
   "from": 1967,
   "to": 2000
  }
 ]
}